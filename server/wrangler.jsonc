{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-08-15",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "webapp-files"
    }
  ],
  // NOTE: Workers AI binding is intentionally commented out for LOCAL DEV.
  // `wrangler pages dev` has no offline emulation for the AI binding — it always
  // tries to proxy to real Cloudflare infra and requires CLOUDFLARE_API_TOKEN in
  // this non-interactive sandbox, which breaks local startup entirely.
  // embeddings.ts already falls back to pseudoEmbed() when env.AI is undefined,
  // so local dev works correctly with this removed. RE-ADD before real deployment:
  // "ai": { "binding": "AI" },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
  // "vars": {
  //   "LLM_MODEL": "gpt-5-mini"
  // }
  // BYOK-only (not supported by gsk-hosted-deploy): if you deploy to your own
  // Cloudflare account and want to use Supabase for vector RAG instead of the
  // D1 fallback store, set these as secrets (never commit real values):
  //   SUPABASE_URL, SUPABASE_SERVICE_KEY            (single project)
  //   SUPABASE_ACCOUNTS_JSON                        (pool of many projects, see below)
  // and Expo push notifications:
  //   EXPO_ACCESS_TOKEN (optional, only needed for very high volume)
  //
  // Provider integrations added for Kaggle / E2B / multi-account Supabase
  // (server/src/lib/kaggle.ts, e2b.ts, supabase.ts, credentialPool.ts).
  // ALL of these are optional Worker secrets — set with:
  //   npx wrangler pages secret put <NAME>   (production)
  //   or add to server/.dev.vars             (local dev, gitignored)
  //
  // Kaggle (https://www.kaggle.com/settings -> API -> "Create New Token"):
  //   KAGGLE_TOKEN                          single account, NEW "KGAT_..." bearer
  //                                          token (recommended format going forward), OR
  //   KAGGLE_USERNAME + KAGGLE_KEY          single account, legacy username+key pair, OR
  //   KAGGLE_ACCOUNTS_JSON                   pool of many accounts, mixing both formats
  //                                          is fine, e.g.:
  //     [{"token":"KGAT_xxxx","label":"acct1"},{"username":"acct2","key":"yyyy"}, ...]
  //
  // E2B (https://e2b.dev/dashboard -> API Keys):
  //   E2B_API_KEY                          single account, OR
  //   E2B_ACCOUNTS_JSON                     pool of many accounts, e.g.:
  //     [{"apiKey":"e2b_xxx","label":"acct1"},{"apiKey":"e2b_yyy","label":"acct2"}, ...]
  //
  // Supabase pool (https://app.supabase.com -> Project Settings -> API,
  // use the SERVICE ROLE key, not anon):
  //   SUPABASE_ACCOUNTS_JSON                 pool of many projects, e.g.:
  //     [{"url":"https://xxx.supabase.co","serviceKey":"eyJ...","label":"acct1"}, ...]
  //   Workspaces are pinned to one project by a hash of workspaceId (sticky
  //   sharding) so a workspace's rows/embeddings always land in — and are
  //   read back from — the same project. Kaggle/E2B/Firecrawl/Hugging Face
  //   pools use plain round-robin instead since those calls are stateless.
  //
  // Firecrawl (https://www.firecrawl.dev/app/api-keys) — web scrape/search/map:
  //   FIRECRAWL_API_KEY                    single account, OR
  //   FIRECRAWL_ACCOUNTS_JSON               pool of many accounts, e.g.:
  //     [{"apiKey":"fc-xxxx","label":"acct1"},{"apiKey":"fc-yyyy","label":"acct2"}, ...]
  //
  // Hugging Face (https://huggingface.co/settings/tokens — fine-grained token
  // with "Make calls to Inference Providers" permission) — open-model text
  // generation + embeddings:
  //   HUGGINGFACE_API_KEY                  single account, OR
  //   HUGGINGFACE_ACCOUNTS_JSON             pool of many accounts, e.g.:
  //     [{"token":"hf_xxxx","label":"acct1"},{"token":"hf_yyyy","label":"acct2"}, ...]
  //
  // Cloudflare (for BYOK deploys only — set via the Deploy panel, not here):
  //   CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN
}