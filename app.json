{
  "expo": {
    "name": "Nova",
    "slug": "nova",
    "version": "1.1.0",
    "scheme": "nova",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon-nova-primary.png",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nova uses your photos when you choose to import media.",
          "cameraPermission": "Nova uses the camera only when you tap Capture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Nova uses your media library when you choose to index media.",
          "savePhotosPermission": "Nova saves captured media only when you request it."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-nova-notification-v2.png",
          "color": "#55d6ff"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "im.nova.workspace",
      "infoPlist": {
        "NSCameraUsageDescription": "Nova uses the camera only when you tap Capture.",
        "NSMicrophoneUsageDescription": "Nova uses the microphone only for audio capture.",
        "NSPhotoLibraryUsageDescription": "Nova uses your photos when you choose to import media."
      }
    },
    "android": {
      "package": "im.nova.workspace",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-nova-foreground.png",
        "backgroundColor": "#07111f",
        "monochromeImage": "./assets/icon-nova-monochrome-v2.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon-nova-settings-v2.png"
    },
    "extra": {
      "novaIcons": {
        "primary": "./assets/icon-nova-primary.png",
        "adaptive": "./assets/icon-nova-foreground.png",
        "monochrome": "./assets/icon-nova-monochrome-v2.png",
        "notification": "./assets/icon-nova-notification-v2.png",
        "settings": "./assets/icon-nova-settings-v2.png",
        "widget": "./assets/icon-nova-widget.png",
        "badge": "./assets/icon-nova-badge.png",
        "shortcut": "./assets/icon-nova-shortcut.png",
        "splash": "./assets/icon-nova-splash.png",
        "share": "./assets/icon-nova-share.png"
      }
    }
  }
}
