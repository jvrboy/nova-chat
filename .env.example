# Nova Chat environment
# Copy to .env and fill in your values

# Local Prisma/SQLite (dev fallback when Supabase isn't configured)
DATABASE_URL="file:./dev.db"

# Supabase (production persistence — leave empty for local SQLite dev)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare deployment
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Optional: Per-provider API keys for backend tools (also settable via Settings → API Keys in-app)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
HUGGINGFACE_TOKEN=""
GITHUB_TOKEN=""
FIRECRAWL_API_KEY=""
